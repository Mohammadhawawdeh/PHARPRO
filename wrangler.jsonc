{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pharpro",
  "compatibility_date": "2026-08-25",
  "main": "cloudflare-worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
